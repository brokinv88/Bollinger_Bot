//@version=6
// Strategy Lab v1: FUTURES_H4_H1_PULLBACK. Read README_VI.md before use.
// Chart-only research monitor. Funding, portfolio ranking and Binance margin absent.
strategy("Strategy Lab B | Futures H4-H1 pullback | Research", overlay = true, initial_capital = 1000, currency = currency.USD, pyramiding = 0, default_qty_type = strategy.fixed, commission_type = strategy.commission.percent, commission_value = 0.05, slippage = 1, margin_long = 33.333333, margin_short = 33.333333, calc_on_every_tick = false, calc_on_order_fills = false, process_orders_on_close = false, use_bar_magnifier = false)

bool dateFilter = input.bool(false, "Giới hạn ngày khi backtest", group = "Theo dõi")
int startDate = input.time(timestamp("01 Jan 2022 00:00 +0000"), "Bắt đầu UTC", group = "Theo dõi")
int endDate = input.time(timestamp("01 Sep 2026 00:00 +0000"), "Kết thúc UTC (không gồm ngày này)", group = "Theo dõi")
bool guardrails = input.bool(true, "Giảm rủi ro DD 8%; dừng mở mới DD 12% trên chart", group = "Theo dõi")
bool liquidityProxy = input.bool(true, "Lọc thanh khoản ƯỚC TÍNH; xác nhận lại bằng scanner", group = "Theo dõi")
string alertMode = input.string("Tín hiệu setup", "Cảnh báo", options = ["Tín hiệu setup", "Lệnh mô phỏng đủ điều kiện"], group = "Theo dõi")

if barstate.isfirst
    if not chart.is_standard or timeframe.in_seconds() != 3600
        runtime.error("Dùng nến tiêu chuẩn khung 1 giờ (60), không dùng Heikin Ashi/Renko.")
    if syminfo.prefix != "BINANCE" or syminfo.currency != "USDT" or not str.endswith(syminfo.ticker, ".P")
        runtime.error("Setup B dành cho Binance perpetual USDT, ví dụ BINANCE:BTCUSDT.P.")
    if dateFilter and startDate >= endDate
        runtime.error("Ngày bắt đầu phải trước ngày kết thúc.")

f_ema(float source, int length) =>
    float alpha = 2.0 / (length + 1.0)
    var float value = na
    value := na(value[1]) ? source : alpha * source + (1.0 - alpha) * value[1]
    value

f_h4() =>
    float e50 = f_ema(close, 50)
    float e200 = f_ema(close, 200)
    // Complete H4 close at [1]; its EMA50 three H4 candles ago is [4].
    [close[1], e50[1], e200[1], e50[4], bar_index[1] + 1]

f_daily() =>
    float turnover = syminfo.volumetype == "quote" ? volume : syminfo.volumetype == "base" ? volume * close : na
    float median30 = ta.median(turnover, 30)
    [median30[1], bar_index[1] + 1]

[h4Close, h4Ema50, h4Ema200, h4Ema50Ago3, h4Count] = request.security(syminfo.tickerid, "240", f_h4(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
[dTurnover, dailyCount] = request.security(syminfo.tickerid, "1D", f_daily(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
float ema20 = f_ema(close, 20)
float ema50 = f_ema(close, 50)
float atr14 = ta.rma(ta.tr(true), 14)
bool warm = h4Count >= 200 and dailyCount >= 30 and bar_index >= 50 and not na(atr14)
bool trendLong = h4Ema50 > h4Ema200 and h4Close > h4Ema50 and h4Ema50 > h4Ema50Ago3
bool trendShort = h4Ema50 < h4Ema200 and h4Close < h4Ema50 and h4Ema50 < h4Ema50Ago3
bool liquid = not liquidityProxy or (not na(dTurnover) and dTurnover >= 20000000.0)
bool triggerLong = low[1] <= ema20[1] and close[1] > ema50[1] and close > high[1] and ema20 > ema50
bool triggerShort = high[1] >= ema20[1] and close[1] < ema50[1] and close < low[1] and ema20 < ema50
bool inDates = not dateFilter or (time >= startDate and time_close < endDate)
bool setupLong = barstate.isconfirmed and warm and liquid and trendLong and triggerLong and inDates
bool setupShort = barstate.isconfirmed and warm and liquid and trendShort and triggerShort and inDates

float equity = math.max(strategy.equity, 0.0)
var float peakEquity = strategy.initial_capital
peakEquity := math.max(peakEquity, equity)
float drawdown = peakEquity > 0.0 ? 1.0 - equity / peakEquity : 1.0
var bool researchHalt = false
if guardrails and drawdown >= 0.12
    researchHalt := true
float riskScale = guardrails and drawdown >= 0.08 ? 0.5 : 1.0
float riskBudget = equity * (12.50 / 1000.0) * riskScale
float notionalCap = equity * riskScale
float candidateStopTicks = math.max(1.0, math.ceil(2.0 * atr14 / syminfo.mintick))
float candidateDistance = candidateStopTicks * syminfo.mintick
// Conservative size estimate: fee 5bps + slip 3bps EACH SIDE; no funding budget.
float unitRisk = (candidateDistance + close * 2.0 * (0.0005 + 0.0003)) * syminfo.pointvalue
float unitNotional = close * (1.0 + 0.0003) * syminfo.pointvalue
float rawQty = unitRisk > 0 and unitNotional > 0 ? math.min(riskBudget / unitRisk, notionalCap / unitNotional) : 0.0
float qtyStep = math.max(syminfo.mincontract, 0.00000001)
float estimatedQty = math.floor(rawQty / qtyStep) * qtyStep
// A signal on an exit bar may submit an order for the NEXT open, never same-bar entry.
bool canEnter = strategy.position_size == 0 and not researchHalt and estimatedQty > 0 and candidateDistance < close
bool enterLong = setupLong and canEnter
bool enterShort = setupShort and canEnter
var float fixedStopTicks = na
var float fixedProfitTicks = na

if enterLong or enterShort
    fixedStopTicks := candidateStopTicks
    fixedProfitTicks := candidateStopTicks * 3.0
    if enterLong
        strategy.entry("L", strategy.long, qty = estimatedQty, alert_message = "B: simulated LONG fill; monitor only")
        strategy.exit("L-SL-TP", from_entry = "L", loss = fixedStopTicks, profit = fixedProfitTicks, alert_message = "B: simulated stop/target fill; monitor only")
    else
        strategy.entry("S", strategy.short, qty = estimatedQty, alert_message = "B: simulated SHORT fill; monitor only")
        strategy.exit("S-SL-TP", from_entry = "S", loss = fixedStopTicks, profit = fixedProfitTicks, alert_message = "B: simulated stop/target fill; monitor only")

if (alertMode == "Tín hiệu setup" ? (setupLong or setupShort) : (enterLong or enterShort))
    alert("RESEARCH B FUTURES " + (setupLong ? "LONG" : "SHORT") + " | " + syminfo.tickerid + " | H1 close UTC " + str.format_time(time_close, "yyyy-MM-dd HH:mm", "UTC") + " | SL distance=" + str.tostring(candidateDistance, format.mintick) + " | TP=3R | estimated qty=" + str.tostring(estimatedQty) + " | Check scanner, funding and portfolio risk. No real order.", alert.freq_once_per_bar_close)

int barsHeld = strategy.opentrades > 0 ? bar_index - strategy.opentrades.entry_bar_index(0) + 1 : 0
if strategy.position_size > 0
    strategy.exit("L-SL-TP", from_entry = "L", loss = fixedStopTicks, profit = fixedProfitTicks, alert_message = "B: simulated stop/target fill; monitor only")
if strategy.position_size < 0
    strategy.exit("S-SL-TP", from_entry = "S", loss = fixedStopTicks, profit = fixedProfitTicks, alert_message = "B: simulated stop/target fill; monitor only")
if strategy.position_size != 0
    if barsHeld >= 72
        strategy.close_all(comment = "Time exit 72 H1", alert_message = "B: simulated time exit; monitor only")
    else if dateFilter and time_close >= endDate
        strategy.close_all(comment = "Date window end", alert_message = "B: simulated end-of-window exit; monitor only")

float direction = math.sign(strategy.position_size)
float actualStop = strategy.position_size != 0 ? strategy.position_avg_price - direction * fixedStopTicks * syminfo.mintick : na
float actualTarget = strategy.position_size != 0 ? strategy.position_avg_price + direction * fixedProfitTicks * syminfo.mintick : na
plot(ema20, "H1 EMA20", color = color.orange)
plot(ema50, "H1 EMA50", color = color.blue)
plot(actualStop, "Stop từ giá khớp mô phỏng", color = color.red, style = plot.style_linebr, linewidth = 2)
plot(actualTarget, "Target từ giá khớp mô phỏng", color = color.lime, style = plot.style_linebr, linewidth = 2)
plotshape(setupLong and not enterLong, title = "Setup LONG; chart không mở vị thế", style = shape.circle, location = location.belowbar, color = color.orange, size = size.tiny)
plotshape(setupShort and not enterShort, title = "Setup SHORT; chart không mở vị thế", style = shape.circle, location = location.abovebar, color = color.orange, size = size.tiny)
plotshape(enterLong, title = "LONG tại đóng H1; khớp mở nến sau", style = shape.triangleup, location = location.belowbar, color = color.lime, size = size.small, text = "B L")
plotshape(enterShort, title = "SHORT tại đóng H1; khớp mở nến sau", style = shape.triangledown, location = location.abovebar, color = color.red, size = size.small, text = "B S")
bgcolor(researchHalt ? color.new(color.red, 90) : na, title = "Dừng nghiên cứu trên chart")
plot(dTurnover, "Median turnover30 ước tính", display = display.data_window)

var table status = table.new(position.top_right, 2, 10, border_width = 1)
if barstate.islast
    table.cell(status, 0, 0, "B · FUTURES H4/H1", text_color = color.white, bgcolor = color.new(color.blue, 30))
    table.cell(status, 1, 0, "RESEARCH ONLY", text_color = color.orange, bgcolor = color.new(color.blue, 30))
    table.cell(status, 0, 1, "H4 ≥200 / D1 ≥30", text_color = chart.fg_color)
    table.cell(status, 1, 1, warm ? "Đủ" : "Chưa đủ", text_color = chart.fg_color)
    table.cell(status, 0, 2, "H4 đã xác nhận", text_color = chart.fg_color)
    table.cell(status, 1, 2, trendLong ? "LONG" : trendShort ? "SHORT" : "Chờ", text_color = chart.fg_color)
    table.cell(status, 0, 3, "Thanh khoản ƯỚC TÍNH", text_color = chart.fg_color)
    table.cell(status, 1, 3, (liquidityProxy ? "Bật · " : "Tắt · ") + str.tostring(dTurnover, format.volume), text_color = color.orange)
    table.cell(status, 0, 4, "Rủi ro / cap chart ($)", text_color = chart.fg_color)
    table.cell(status, 1, 4, str.tostring(riskBudget, "#.##") + " / " + str.tostring(notionalCap, "#.##"), text_color = chart.fg_color)
    table.cell(status, 0, 5, "DD đóng nến / trạng thái", text_color = chart.fg_color)
    table.cell(status, 1, 5, str.tostring(drawdown * 100.0, "#.##") + "% / " + (researchHalt ? "DỪNG" : riskScale < 1 ? "1/2 risk" : "Cơ sở"), text_color = chart.fg_color)
    table.cell(status, 0, 6, "Vị thế / số nến giữ", text_color = chart.fg_color)
    table.cell(status, 1, 6, (strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "Không có") + " / " + str.tostring(barsHeld), text_color = chart.fg_color)
    table.cell(status, 0, 7, "Phí / trượt giá mặc định", text_color = chart.fg_color)
    table.cell(status, 1, 7, "0.05% / 1 tick (Properties)", text_color = color.orange)
    table.cell(status, 0, 8, "Thiếu trong mô phỏng TV", text_color = chart.fg_color)
    table.cell(status, 1, 8, "Funding + danh mục + mark price", text_color = color.orange)
    table.cell(status, 0, 9, "Cảnh báo", text_color = chart.fg_color)
    table.cell(status, 1, 9, "alert() tại đóng nến; không đặt lệnh", text_color = chart.fg_color)
