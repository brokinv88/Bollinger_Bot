//@version=6
// Strategy Lab v1: SPOT_D1_H4_BREAKOUT. Read README_VI.md before use.
// Chart-only research monitor. Not the multi-symbol Python portfolio backtest.
strategy("Strategy Lab A | Spot D1-H4 breakout | Research", overlay = true, initial_capital = 3000, currency = currency.USD, pyramiding = 0, default_qty_type = strategy.fixed, commission_type = strategy.commission.percent, commission_value = 0.10, slippage = 1, margin_long = 100, margin_short = 100, calc_on_every_tick = false, calc_on_order_fills = false, process_orders_on_close = false, use_bar_magnifier = false)

bool dateFilter = input.bool(false, "Giới hạn ngày khi backtest", group = "Theo dõi")
int startDate = input.time(timestamp("01 Jan 2022 00:00 +0000"), "Bắt đầu UTC", group = "Theo dõi")
int endDate = input.time(timestamp("01 Sep 2026 00:00 +0000"), "Kết thúc UTC (không gồm ngày này)", group = "Theo dõi")
bool guardrails = input.bool(true, "Giảm rủi ro DD 8%; dừng mở mới DD 12% trên chart", group = "Theo dõi")
bool liquidityProxy = input.bool(true, "Lọc thanh khoản ƯỚC TÍNH; xác nhận lại bằng scanner", group = "Theo dõi")
string alertMode = input.string("Tín hiệu setup", "Cảnh báo", options = ["Tín hiệu setup", "Lệnh mô phỏng đủ điều kiện"], group = "Theo dõi")

if barstate.isfirst
    if not chart.is_standard or timeframe.in_seconds() != 14400
        runtime.error("Dùng nến tiêu chuẩn khung 4 giờ (240), không dùng Heikin Ashi/Renko.")
    if syminfo.prefix != "BINANCE" or syminfo.currency != "USDT" or str.endswith(syminfo.ticker, ".P")
        runtime.error("Setup A dành cho Binance spot, cặp USDT; ví dụ BINANCE:BTCUSDT.")
    if dateFilter and startDate >= endDate
        runtime.error("Ngày bắt đầu phải trước ngày kết thúc.")

// Each written call has its own history. Seed EMA at the first available close.
f_ema(float source, int length) =>
    float alpha = 2.0 / (length + 1.0)
    var float value = na
    value := na(value[1]) ? source : alpha * source + (1.0 - alpha) * value[1]
    value

// All HTF tuple elements are shifted INSIDE the requested context.
// These values were known at the OPEN of the current signal H4 candle.
f_daily() =>
    float e50 = f_ema(close, 50)
    float e200 = f_ema(close, 200)
    float roc20 = ta.roc(close, 20)
    float turnover = syminfo.volumetype == "quote" ? volume : syminfo.volumetype == "base" ? volume * close : na
    float median30 = ta.median(turnover, 30)
    [close[1], e50[1], e200[1], roc20[1], median30[1], bar_index[1] + 1]

[dClose, dEma50, dEma200, dRoc20, dTurnover, dailyCount] = request.security(syminfo.tickerid, "1D", f_daily(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
[btcClose, btcEma50, btcEma200, btcRoc20, btcTurnover, btcDailyCount] = request.security("BINANCE:BTCUSDT", "1D", f_daily(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)

float ema20 = f_ema(close, 20)
// ta.tr(true) uses high-low on the first bar. RMA starts with SMA of 14 TRs.
float atr14 = ta.rma(ta.tr(true), 14)
float prior20High = ta.highest(high, 20)[1]
bool warm = dailyCount >= 200 and btcDailyCount >= 200 and bar_index >= 21 and not na(atr14)
bool trend = dEma50 > dEma200 and dClose > dEma50 and btcClose > btcEma200
bool relativeStrong = syminfo.basecurrency == "BTC" or dRoc20 > btcRoc20
bool liquid = not liquidityProxy or (not na(dTurnover) and dTurnover >= 10000000.0)
bool breakout = close > prior20High and close[1] <= prior20High[1] and close > ema20
bool inDates = not dateFilter or (time >= startDate and time_close < endDate)
bool setup = barstate.isconfirmed and warm and trend and relativeStrong and liquid and breakout and inDates

// Local-chart guardrails; cannot see another coin, account balance or open trade.
float equity = math.max(strategy.equity, 0.0)
var float peakEquity = strategy.initial_capital
peakEquity := math.max(peakEquity, equity)
float drawdown = peakEquity > 0.0 ? 1.0 - equity / peakEquity : 1.0
var bool researchHalt = false
if guardrails and drawdown >= 0.12
    researchHalt := true
float riskScale = guardrails and drawdown >= 0.08 ? 0.5 : 1.0
float riskBudget = equity * (20.0 / 3000.0) * riskScale
float notionalCap = equity * 0.25 * riskScale

// Freeze tick distances when the signal closes, before the next-open fill.
// Relative loss/profit levels are anchored by the broker emulator to actual fill.
float candidateStopTicks = math.max(1.0, math.ceil(2.0 * atr14 / syminfo.mintick))
float candidateDistance = candidateStopTicks * syminfo.mintick
// Conservative size estimate: fee 10bps + slip 5bps EACH SIDE. Properties may differ.
float unitRisk = (candidateDistance + close * 2.0 * (0.0010 + 0.0005)) * syminfo.pointvalue
float unitNotional = close * (1.0 + 0.0005) * syminfo.pointvalue
float rawQty = unitRisk > 0 and unitNotional > 0 ? math.min(riskBudget / unitRisk, notionalCap / unitNotional) : 0.0
float qtyStep = math.max(syminfo.mincontract, 0.00000001)
float estimatedQty = math.floor(rawQty / qtyStep) * qtyStep
// A signal on an exit bar may submit a new order for the NEXT bar; never same-bar entry.
bool enterLong = setup and strategy.position_size == 0 and not researchHalt and estimatedQty > 0 and candidateDistance < close
var float fixedStopTicks = na
var float fixedProfitTicks = na

if enterLong
    fixedStopTicks := candidateStopTicks
    fixedProfitTicks := candidateStopTicks * 3.0
    strategy.entry("L", strategy.long, qty = estimatedQty, alert_message = "A: simulated LONG fill; monitor only")
    strategy.exit("L-SL-TP", from_entry = "L", loss = fixedStopTicks, profit = fixedProfitTicks, alert_message = "A: simulated stop/target fill; monitor only")

if (alertMode == "Tín hiệu setup" ? setup : enterLong)
    alert("RESEARCH A SPOT LONG | " + syminfo.tickerid + " | H4 close UTC " + str.format_time(time_close, "yyyy-MM-dd HH:mm", "UTC") + " | SL distance=" + str.tostring(candidateDistance, format.mintick) + " | TP=3R | estimated qty=" + str.tostring(estimatedQty) + " | Confirm scanner liquidity and portfolio risk. No real order.", alert.freq_once_per_bar_close)

int barsHeld = strategy.opentrades > 0 ? bar_index - strategy.opentrades.entry_bar_index(0) + 1 : 0
if strategy.position_size > 0
    strategy.exit("L-SL-TP", from_entry = "L", loss = fixedStopTicks, profit = fixedProfitTicks, alert_message = "A: simulated stop/target fill; monitor only")
    // Entry bar is bar 1; at close of bar 90 submit a next-open time exit.
    if barsHeld >= 90
        strategy.close("L", comment = "Time exit 90 H4", alert_message = "A: simulated time exit; monitor only")
    else if dateFilter and time_close >= endDate
        strategy.close("L", comment = "Date window end", alert_message = "A: simulated end-of-window exit; monitor only")

float actualStop = strategy.position_size > 0 ? strategy.position_avg_price - fixedStopTicks * syminfo.mintick : na
float actualTarget = strategy.position_size > 0 ? strategy.position_avg_price + fixedProfitTicks * syminfo.mintick : na
plot(ema20, "H4 EMA20", color = color.orange)
plot(prior20High, "Đỉnh 20 nến trước", color = color.new(color.blue, 25), style = plot.style_stepline)
plot(actualStop, "Stop từ giá khớp mô phỏng", color = color.red, style = plot.style_linebr, linewidth = 2)
plot(actualTarget, "Target từ giá khớp mô phỏng", color = color.lime, style = plot.style_linebr, linewidth = 2)
plotshape(setup and not enterLong, title = "Setup xuất hiện; chart không mở vị thế", style = shape.circle, location = location.belowbar, color = color.orange, size = size.tiny)
plotshape(enterLong, title = "LONG tại đóng H4; khớp mở nến sau", style = shape.triangleup, location = location.belowbar, color = color.lime, size = size.small, text = "A")
bgcolor(researchHalt ? color.new(color.red, 90) : na, title = "Dừng nghiên cứu trên chart")
plot(dTurnover, "Median turnover30 ước tính", display = display.data_window)
plot(dRoc20 - btcRoc20, "ROC20 so với BTC (điểm %)", display = display.data_window)

var table status = table.new(position.top_right, 2, 10, border_width = 1)
if barstate.islast
    table.cell(status, 0, 0, "A · SPOT D1/H4", text_color = color.white, bgcolor = color.new(color.blue, 30))
    table.cell(status, 1, 0, "RESEARCH ONLY", text_color = color.orange, bgcolor = color.new(color.blue, 30))
    table.cell(status, 0, 1, "D1 đã đủ 200 nến?", text_color = chart.fg_color)
    table.cell(status, 1, 1, warm ? "Có" : "Chưa", text_color = chart.fg_color)
    table.cell(status, 0, 2, "Xu hướng + RS", text_color = chart.fg_color)
    table.cell(status, 1, 2, trend and relativeStrong ? "Đạt" : "Chờ", text_color = chart.fg_color)
    table.cell(status, 0, 3, "Thanh khoản ƯỚC TÍNH", text_color = chart.fg_color)
    table.cell(status, 1, 3, (liquidityProxy ? "Bật · " : "Tắt · ") + str.tostring(dTurnover, format.volume), text_color = color.orange)
    table.cell(status, 0, 4, "Rủi ro / cap chart ($)", text_color = chart.fg_color)
    table.cell(status, 1, 4, str.tostring(riskBudget, "#.##") + " / " + str.tostring(notionalCap, "#.##"), text_color = chart.fg_color)
    table.cell(status, 0, 5, "DD đóng nến / trạng thái", text_color = chart.fg_color)
    table.cell(status, 1, 5, str.tostring(drawdown * 100.0, "#.##") + "% / " + (researchHalt ? "DỪNG" : riskScale < 1 ? "1/2 risk" : "Cơ sở"), text_color = chart.fg_color)
    table.cell(status, 0, 6, "Vị thế / số nến giữ", text_color = chart.fg_color)
    table.cell(status, 1, 6, strategy.position_size > 0 ? "LONG / " + str.tostring(barsHeld) : "Không có", text_color = chart.fg_color)
    table.cell(status, 0, 7, "Phí / trượt giá mặc định", text_color = chart.fg_color)
    table.cell(status, 1, 7, "0.10% / 1 tick (Properties)", text_color = color.orange)
    table.cell(status, 0, 8, "Danh mục", text_color = chart.fg_color)
    table.cell(status, 1, 8, "1 chart; không xếp hạng coin", text_color = color.orange)
    table.cell(status, 0, 9, "Cảnh báo", text_color = chart.fg_color)
    table.cell(status, 1, 9, "alert() tại đóng nến; không đặt lệnh", text_color = chart.fg_color)
