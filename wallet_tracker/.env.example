# Copy thành wallet_tracker/.env rồi điền. File .env đã gitignore.
WT_TELEGRAM_BOT_TOKEN=
WT_TELEGRAM_CHAT_ID=
# Bắt buộc cho Solana (free tier: https://dashboard.helius.dev)
HELIUS_API_KEY=
# Tùy chọn: chấm PnL/winrate ví + insider/bundler (free dev key: https://developers.zerion.io)
ZERION_API_KEY=
# App web: mật khẩu khi mở bằng --host 0.0.0.0
WT_WEB_PASSWORD=
# Tùy chọn: thay RPC public bằng RPC riêng (Alchemy/QuickNode free) nếu bị giới hạn
# BASE_RPC_URL=
# BSC_RPC_URL=
# ETH_RPC_URL=
# Robinhood Chain: điền khi có RPC mainnet; ROBINHOOD_QUOTES = WETH,USDC,... cách nhau dấu phẩy
# ROBINHOOD_RPC_URL=
# ROBINHOOD_QUOTES=
# Chỉ bật một số chain:
# WT_CHAINS=solana,base,bsc,ethereum,robinhood
# WT_POLL_INTERVAL_S=30
